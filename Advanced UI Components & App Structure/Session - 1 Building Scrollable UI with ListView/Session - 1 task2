Modify your ListView to display each IPL team inside a Card widget with padding and a leading Icon (use Icons.sports_cricket), so the 
list looks similar to a sports app's team list.<br><br><em><strong>Hint:</strong> Use ListView's children property and wrap each Card 
with Padding for better spacing.</em>

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'IPL Teams',
      theme: ThemeData(
        primarySwatch: Colors.orange,
      ),
      home: const IPLTeamScreen(),
    );
  }
}

