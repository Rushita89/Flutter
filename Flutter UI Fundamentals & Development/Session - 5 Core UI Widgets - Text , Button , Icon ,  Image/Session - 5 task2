            const SizedBox(height: 20),
            const Text(
              'Kesariya',
              style: TextStyle(
                fontSize: 32,
                fontWeight: FontWeight.bold,
                color: Colors.white,
              ),
            ),
            const SizedBox(height: 10),
            const Text(
              'Arijit Singh',
              style: TextStyle(
                fontSize: 20,
                color: Colors.green,
                fontStyle: FontStyle.italic,
              ),
