import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: SpotifyPlaylist(),
    );
  }
}

class SpotifyPlaylist extends StatelessWidget {
  const SpotifyPlaylist({super.key});

  @override
  Widget build(BuildContext context) {
    final screenSize = MediaQuery.of(context).size;

    final screenWidth = screenSize.width;
    final screenHeight = screenSize.height;

    final cardWidth = screenWidth * 0.85;
    final cardPadding = screenWidth * 0.05;
    final iconSize = screenWidth * 0.12;
    final titleSize = screenWidth * 0.055;
    final songSize = screenWidth * 0.04;
    final spacing = screenHeight * 0.02;
    final cornerRadius = screenWidth * 0.05;

    return Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        title: const Text('Spotify Playlist'),
        backgroundColor: Colors.black,
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: Container(
          width: cardWidth,
          padding: EdgeInsets.all(cardPadding),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [
                Color(0xFF1DB954),
                Color(0xFF075E36),
              ],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(cornerRadius),
            boxShadow: [
              BoxShadow(
                color: Colors.green.withOpacity(0.4),
                blurRadius: screenWidth * 0.04,
                spreadRadius: screenWidth * 0.01,
                offset: Offset(0, screenHeight * 0.008),
              ),
            ],
          ),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Icon(
                Icons.music_note,
                color: Colors.white,
                size: iconSize,
              ),
              SizedBox(height: spacing),
              Text(
                'My Favorite Playlist',
                style: TextStyle(
                  color: Colors.white,
                  fontSize: titleSize,
                  fontWeight: FontWeight.bold,
                ),
              ),
              SizedBox(height: spacing / 2),
              Text(
                '25 Songs',
                style: TextStyle(
                  color: Colors.white70,
                  fontSize: songSize,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
