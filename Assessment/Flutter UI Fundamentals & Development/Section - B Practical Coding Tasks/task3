Task 3: Food Item Quantity Counter

Build a Flutter screen where the user taps + and – buttons to adjust the quantity of a food item and the total price updates live with 
each tap.

->Create a StatefulWidget screen that displays a food item name, its unit price and a quantity counter initialised to 0.
->Implement onPressed handlers for + and – ElevatedButtons that use setState() to increment and decrement the quantity; prevent the 
quantity from going below 0.
->Compute and display the total price (quantity × unit price) in a Text widget that recalculates and re-renders with every setState() 
call.
->Lay out all elements in a Column with sufficient padding and use a Text widget with a larger font size to make the counter readable.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(
    debugShowCheckedModeBanner: false,
    home: FoodCounter(),
  ));
}

class FoodCounter extends StatefulWidget {
  @override
  State<FoodCounter> createState() => FoodCounterState();
}

class FoodCounterState extends State<FoodCounter> {
  int quantity = 0;
  double price = 250.0;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Food Quantity Counter"),
        backgroundColor: Colors.deepOrange,
      ),
      body: Padding(
        padding: EdgeInsets.all(25),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              Icons.local_pizza,
              size: 100,
              color: Colors.deepOrange,
            ),
            SizedBox(height: 20),

            Text(
              "Pizza",
              style: TextStyle(
                fontSize: 28,
                fontWeight: FontWeight.bold,
              ),
            ),

            SizedBox(height: 10),

            Text(
              "Unit Price: Rs. ${price.toStringAsFixed(2)}",
              style: TextStyle(fontSize: 20),
            ),

            SizedBox(height: 25),

            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                ElevatedButton(
                  onPressed: () {
                    setState(() {
                      if (quantity > 0) {
                        quantity--;
                      }
                    });
                  },
                  child: Text("-", style: TextStyle(fontSize: 25)),
                ),

                SizedBox(width: 30),

                Text(
                  "$quantity",
                  style: TextStyle(
                    fontSize: 30,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                SizedBox(width: 30),

                ElevatedButton(
                  onPressed: () {
                    setState(() {
                      quantity++;
                    });
                  },
                  child: Text("+", style: TextStyle(fontSize: 25)),
                ),
              ],
            ),

            SizedBox(height: 30),

            Text(
              "Total Price: Rs. ${(quantity * price).toStringAsFixed(2)}",
              style: TextStyle(
                fontSize: 23,
                fontWeight: FontWeight.bold,
                color: Colors.green,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

