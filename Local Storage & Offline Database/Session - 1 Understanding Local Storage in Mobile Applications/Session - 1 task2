<p>Extend `study_planner` so the 6 tasks from a successful fetch are kept in a variable `_cachedTasks` inside the home screen's State. 
With the switch off, 'Fetch my tasks' must show the cached tasks under an orange banner 'Offline: showing last copy'; with no copy it 
keeps the old message. Test: fetch online, switch off, fetch again, then hot restart, switch off and fetch again; the old message must 
return. Constraint: Do not use any storage package.</p>


import 'package:flutter/material.dart';

void main() {
  runApp(
    const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: StudyPlannerScreen(),
    ),
  );
}

class StudyPlannerScreen extends StatefulWidget {
  const StudyPlannerScreen({super.key});

  @override
  State<StudyPlannerScreen> createState() =>
      _StudyPlannerScreenState();
}

class _StudyPlannerScreenState
    extends State<StudyPlannerScreen> {

  bool internetAvailable = true;
  bool isLoading = false;

  List<String> tasks = [];

  // Cache tasks in memory
  List<String> _cachedTasks = [];

  // Hard-coded tasks
  final List<String> allTasks = [
    'Maths - Trigonometry - 45 min',
    'Science - Physics - 60 min',
    'English - Grammar - 30 min',
    'Computer - Flutter - 60 min',
    'Gujarati - Reading - 30 min',
    'Social Science - History - 45 min',
  ];

  // Fetch tasks
  Future<void> fetchTasks() async {

    // Internet OFF
    if (!internetAvailable) {
      setState(() {
        isLoading = false;

        if (_cachedTasks.isNotEmpty) {
          tasks = List.from(_cachedTasks);
        } else {
          tasks.clear();
        }
      });

      return;
    }

    // Internet ON
    setState(() {
      isLoading = true;
      tasks.clear();
    });

    // Wait for 2 seconds
    await Future.delayed(
      const Duration(seconds: 2),
    );

    setState(() {
      tasks = List.from(allTasks);

      // Save last fetched tasks in cache
      _cachedTasks = List.from(tasks);

      isLoading = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(

      appBar: AppBar(
        title: const Text('Study Planner'),
        centerTitle: true,
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),

      body: Padding(
        padding: const EdgeInsets.all(16),

        child: Column(
          children: [

            // Internet Switch
            SwitchListTile(
              title: const Text(
                'Internet available',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),

              value: internetAvailable,

              onChanged: (value) {
                setState(() {
                  internetAvailable = value;
                  tasks.clear();
                });
              },
            ),

            const SizedBox(height: 15),

            // Fetch Button
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: isLoading ? null : fetchTasks,
                child: const Text(
                  'Fetch my tasks',
                  style: TextStyle(fontSize: 16),
                ),
              ),
            ),

            const SizedBox(height: 20),

            // Loading Indicator
            if (isLoading)
              const CircularProgressIndicator(),

            // Offline with cached tasks
            if (!internetAvailable &&
                !isLoading &&
                _cachedTasks.isNotEmpty) ...[

              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Colors.orange,
                  borderRadius: BorderRadius.circular(8),
                ),

                child: const Text(
                  'Offline: showing last copy',
                  style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                    fontSize: 16,
                  ),
                  textAlign: TextAlign.center,
                ),
              ),

              const SizedBox(height: 10),

              // Cached task list
              Expanded(
                child: ListView.builder(
                  itemCount: tasks.length,

                  itemBuilder: (context, index) {
                    return Card(
                      child: ListTile(
                        leading: const Icon(
                          Icons.task_alt,
                          color: Colors.green,
                        ),
                        title: Text(tasks[index]),
                      ),
                    );
                  },
                ),
              ),
            ],

            // No cached tasks
            if (!internetAvailable &&
                !isLoading &&
                _cachedTasks.isEmpty)
              const Text(
                'No internet and no saved data',
                style: TextStyle(
                  fontSize: 18,
                  color: Colors.red,
                  fontWeight: FontWeight.bold,
                ),
                textAlign: TextAlign.center,
              ),

            // Online task list
            if (internetAvailable &&
                !isLoading &&
                tasks.isNotEmpty)
              Expanded(
                child: ListView.builder(
                  itemCount: tasks.length,

                  itemBuilder: (context, index) {
                    return Card(
                      child: ListTile(
                        leading: const Icon(
                          Icons.task_alt,
                          color: Colors.green,
                        ),
                        title: Text(tasks[index]),
                      ),
                    );
                  },
                ),
              ),
          ],
        ),
      ),
    );
  }
}
