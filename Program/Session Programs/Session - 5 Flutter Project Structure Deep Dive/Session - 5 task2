Inside main.dart create a MaterialApp with a title 'Foodie Explorer' and set its home property to a Scaffold with an AppBar titled 
'Foodie Explorer Home'. Run the app and verify the AppBar appears at the top.

import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(
    title: 'Foodie Explorer',
    debugShowCheckedModeBanner: false,
    home: FoodieHome(),
  ));
}

class FoodieHome extends StatelessWidget {
  const FoodieHome({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Foodie Explorer Home'),
        backgroundColor: Colors.orange,
      ),
      body: Center(
        child: Text(
          'Welcome to Foodie Explorer!',
          style: TextStyle(
            fontSize: 22,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
    );
  }
}
